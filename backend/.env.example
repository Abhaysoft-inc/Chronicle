# Sarvam API key (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Keep this OUTSIDE OneDrive (sync locks SQLite files). Default: ~/chronicle-data
# DATA_DIR=C:\chronicle-data

PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Optional shared token. If set, every /api request needs header: x-api-token
# API_TOKEN=

# Sarvam limits (docs disagree: Parse is stated as 10 and as 200 req/min; start low)
DOCAI_RPM=10
CHAT_RPM=30
DOCAI_POLL_SECONDS=10
CHAT_MAX_TOKENS=4096

# json_object works everywhere; json_schema is untested for sarvam-105b (Phase 0)
CHAT_JSON_MODE=json_object

# Demo safety: serve only from the cache, never call Sarvam
CACHE_ONLY=false
